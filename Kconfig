menu "Custom Status Screen Configuration"

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

choice CUSTOM_STATUS_SCREEN_ROTATION
    prompt "Status Screen Rotation"
    default CUSTOM_STATUS_SCREEN_ROTATION_90
    help
      Rotation angle for the vertical Corne OLED display.

config CUSTOM_STATUS_SCREEN_ROTATION_90
    bool "90 degrees (standard vertical Corne mounting)"

config CUSTOM_STATUS_SCREEN_ROTATION_270
    bool "270 degrees (inverted 180 degrees)"

endchoice

config CUSTOM_STATUS_SCREEN_INVERT
    bool "Invert display colors"
    default y
    help
      Invert the monochrome display colors (swap black and white for SSD1306).

config CUSTOM_STATUS_SCREEN_IDLE_TIMEOUT_MS
    int "Idle screen timeout in milliseconds"
    default 10000
    help
      Duration of inactivity in milliseconds before switching to the idle screen.

config CUSTOM_STATUS_SCREEN_USER_NAME
    string "Custom text on idle screen"
    default "SCYAN"
    help
      Text displayed on the idle screen (up to 6 characters, uppercase A-Z).

endmenu
