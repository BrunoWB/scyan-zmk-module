menu "Scyan ZMK Display Module"

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

choice SCYAN_ROTATION
    prompt "Status Screen Rotation"
    default SCYAN_ROTATION_90
    help
      Orientation transform angle for Corne vertical OLED displays.

config SCYAN_ROTATION_90
    bool "90 degrees (standard vertical Corne mounting)"

config SCYAN_ROTATION_270
    bool "270 degrees (counter-clockwise)"

config SCYAN_ROTATION_180
    bool "180 degrees (upside-down)"

config SCYAN_ROTATION_0
    bool "0 degrees (horizontal / no rotation)"

endchoice

config SCYAN_INVERT
    bool "Invert display colors"
    default y
    help
      Inverts monochrome pixels (swap black and white).

config SCYAN_IDLE_TIMEOUT_MS
    int "Idle screen timeout in milliseconds"
    default 10000
    help
      Duration of key inactivity in milliseconds before transitioning to the idle screen layout.

config SCYAN_LEFT_IS_CENTRAL
    bool "Map Left screen blocks to Central split role"
    default y
    help
      When enabled, the split Central half renders LAYOUT_LEFT_* blocks and Peripheral renders
      LAYOUT_RIGHT_* blocks. When disabled, Central renders LAYOUT_RIGHT_* and Peripheral renders LAYOUT_LEFT_*.

choice SCYAN_DISPLAY_SLOT
    prompt "Display Layout Slot Selection"
    default SCYAN_DISPLAY_SLOT_AUTO
    help
      Select which slotted display layout this firmware image should render.

config SCYAN_DISPLAY_SLOT_AUTO
    bool "Automatic (Central -> Display 1, Peripheral -> Display 2)"

config SCYAN_DISPLAY_SLOT_1
    bool "Display Slot 1 (Primary / Central / Left)"

config SCYAN_DISPLAY_SLOT_2
    bool "Display Slot 2 (Secondary / Peripheral / Right)"

config SCYAN_DISPLAY_SLOT_3
    bool "Display Slot 3 (Tertiary / Peripheral 2)"

config SCYAN_DISPLAY_SLOT_4
    bool "Display Slot 4 (Quaternary / Auxiliary)"

config SCYAN_DISPLAY_SLOT_5
    bool "Display Slot 5"

config SCYAN_DISPLAY_SLOT_6
    bool "Display Slot 6"

endchoice

config SCYAN_PERIPHERAL_SLOT_2
    bool "Secondary peripheral display layout (Legacy alias for Slot 3)"
    default n
    help
      When enabled on a peripheral half in a multi-peripheral setup, the display renders
      LAYOUT_PERIPHERAL_2_* blocks instead of standard LAYOUT_PERIPHERAL_* blocks.

config SCYAN_USER_NAME
    string "Default branding user name"
    default "SCYAN"
    help
      Default text string rendered by branding widgets when no custom text is supplied.

config SCYAN_BONGO_TAP_MS
    int "Bongo Cat tap duration in milliseconds"
    default 60
    help
      Duration in milliseconds that Bongo Cat holds a paw down before returning to neutral.

endmenu

